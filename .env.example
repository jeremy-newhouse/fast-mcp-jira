# Required: JIRA Cloud Configuration
JIRA_URL=mycompany.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# Optional: SSL Configuration
# Set to false to disable SSL certificate verification (useful for proxies)
JIRA_SSL_VERIFY=true

# Optional: Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=5472

# Optional: Logging
LOG_LEVEL=INFO

# Optional: MCP Endpoint Authentication
# If set, clients must provide this key in the Authorization header:
# Authorization: Bearer <your-api-key>
# Leave unset to allow unauthenticated access (suitable for local development)
# MCP_API_KEY=your-secure-api-key-here

# Optional: Cache Configuration
# CACHE_ENABLED=true
# CACHE_DB_PATH=~/.fast-mcp-jira/cache.db

# Optional: Cache Encryption (requires sqlcipher3-binary package)
# Enable SQLCipher encryption for the cache database
# CACHE_ENCRYPTION_ENABLED=false
# CACHE_ENCRYPTION_KEY=your-encryption-key-at-least-32-characters
# Or use a key file instead:
# CACHE_ENCRYPTION_KEY_FILE=~/.fast-mcp-jira/cache.key

# Optional: Custom Fields Configuration
# Enable dynamic custom field tools from JSON config
# CUSTOM_FIELDS_ENABLED=true
# CUSTOM_FIELDS_CONFIG_FILE=~/.fast-mcp-jira/custom-fields.json

# Optional: Graceful Shutdown Timeout (seconds)
# GRACEFUL_SHUTDOWN_TIMEOUT=30